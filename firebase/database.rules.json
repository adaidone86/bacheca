{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['username', 'name'])",
        "username": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9._-]{3,20}$/)"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10"
        }
      }
    },
    "events": {
      ".read": "auth != null",
      "$eventId": {
        ".write": "auth != null && (data.exists() ? data.child('creatorId').val() === auth.uid : newData.child('creatorId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['id', 'date', 'title']) && newData.child('id').val() === $eventId && (!data.exists() || newData.child('creatorId').val() === data.child('creatorId').val())",
        "date": {
          ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === true"
          }
        },
        "fee": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
        },
        "time": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "location": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "notes": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "link": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().matches(/^color-[a-z]{2,20}$/)"
        },
        "imageVersion": {
          ".validate": "newData.isNumber()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "creatorId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "id": {
          ".validate": "newData.isString()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "eventImages": {
      ".read": "auth != null",
      "$eventId": {
        ".write": "auth != null && (root.child('events/' + $eventId).exists() ? root.child('events/' + $eventId + '/creatorId').val() === auth.uid : (root.child('proposals/' + $eventId).exists() ? root.child('proposals/' + $eventId + '/creatorId').val() === auth.uid : true))",
        ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 100000"
      }
    },
    "eventChats": {
      ".read": "auth != null",
      "$chatId": {
        ".write": "auth != null && !newData.exists() && !newData.parent().parent().child('events/' + $chatId).exists() && !newData.parent().parent().child('proposals/' + $chatId).exists() && (root.child('events/' + $chatId).exists() ? root.child('events/' + $chatId + '/creatorId').val() === auth.uid : (root.child('proposals/' + $chatId).exists() ? root.child('proposals/' + $chatId + '/creatorId').val() === auth.uid : true))",
        "messages": {
          "$messageId": {
            ".write": "auth != null && !data.exists() && newData.exists() && (root.child('events/' + $chatId).exists() ? root.child('events/' + $chatId + '/participants/' + auth.uid).val() === true : root.child('proposals/' + $chatId).exists())",
            ".validate": "newData.hasChildren(['deviceId', 'name', 'text', 'timestamp']) && newData.child('deviceId').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 300"
          }
        }
      }
    },
    "chatReadStatus": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".validate": "newData.hasChildren(['lastReadTimestamp']) && newData.child('lastReadTimestamp').isNumber()"
        }
      }
    },
    "proposals": {
      ".read": "auth != null",
      "$proposalId": {
        ".write": "auth != null && (data.exists() ? (!newData.exists() && data.child('creatorId').val() === auth.uid) : newData.child('creatorId').val() === auth.uid)",
        "dateOptions": {
          "$optionKey": {
            ".write": "auth != null && !data.exists() && newData.exists() && newData.child('addedById').val() === auth.uid && root.child('proposals/' + $proposalId).exists()",
            ".validate": "$optionKey.matches(/^\\d{4}-\\d{2}-\\d{2}(_\\d{4})?$/) && newData.hasChildren(['addedById', 'createdAt']) && newData.child('addedBy').isString() && newData.child('addedBy').val().length <= 40 && newData.child('createdAt').isNumber()",
            "$other": {
              ".validate": "$other === 'addedBy' || $other === 'addedById' || $other === 'createdAt'"
            }
          }
        },
        "votes": {
          "$optionKey": {
            ".validate": "$optionKey.matches(/^\\d{4}-\\d{2}-\\d{2}(_\\d{4})?$/)",
            "$voter": {
              ".write": "auth != null && auth.uid === $voter",
              ".validate": "newData.child('deviceId').val() === $voter && newData.child('name').isString() && newData.child('name').val().length <= 40"
            }
          }
        },
        ".validate": "newData.hasChildren(['id', 'title', 'creatorId']) && newData.child('id').val() === $proposalId && (!data.exists() || newData.child('creatorId').val() === data.child('creatorId').val())",
        "id": {
          ".validate": "newData.isString()"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100",
          ".write": "auth != null && root.child('proposals/' + $proposalId + '/creatorId').val() === auth.uid"
        },
        "time": {
          ".validate": "newData.isString() && newData.val().length <= 30",
          ".write": "auth != null && root.child('proposals/' + $proposalId + '/creatorId').val() === auth.uid"
        },
        "location": {
          ".validate": "newData.isString() && newData.val().length <= 200",
          ".write": "auth != null && root.child('proposals/' + $proposalId + '/creatorId').val() === auth.uid"
        },
        "notes": {
          ".validate": "newData.isString() && newData.val().length <= 500",
          ".write": "auth != null && root.child('proposals/' + $proposalId + '/creatorId').val() === auth.uid"
        },
        "link": {
          ".validate": "newData.isString() && newData.val().length <= 500",
          ".write": "auth != null && root.child('proposals/' + $proposalId + '/creatorId').val() === auth.uid"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().matches(/^color-[a-z]{2,20}$/)",
          ".write": "auth != null && root.child('proposals/' + $proposalId + '/creatorId').val() === auth.uid"
        },
        "fee": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999",
          ".write": "auth != null && root.child('proposals/' + $proposalId + '/creatorId').val() === auth.uid"
        },
        "imageVersion": {
          ".validate": "newData.isNumber()",
          ".write": "auth != null && root.child('proposals/' + $proposalId + '/creatorId').val() === auth.uid"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "creatorId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "creatorName": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "fixedDate": {
          ".validate": "newData.isString() && newData.val().length <= 20",
          ".write": "auth != null && root.child('proposals/' + $proposalId + '/creatorId').val() === auth.uid"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "$connectionId": {
          ".validate": "!newData.exists() || newData.hasChildren(['active']) && newData.child('active').isBoolean()"
        }
      }
    }
  }
}
