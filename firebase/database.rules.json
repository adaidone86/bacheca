{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['username', 'name'])",
        "username": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9._-]{3,20}$/)"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        }
      }
    },
    "events": {
      ".read": "auth != null",
      "$eventId": {
        ".write": "auth != null && (data.exists() ? data.child('creatorId').val() === auth.uid : newData.child('creatorId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['id', 'date', 'title']) && newData.child('id').val() === $eventId && (!data.exists() || newData.child('creatorId').val() === data.child('creatorId').val())",
        "date": {
          ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === true"
          }
        },
        "fee": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        }
      }
    },
    "eventImages": {
      ".read": "auth != null",
      "$eventId": {
        ".write": "auth != null && (root.child('events/' + $eventId).exists() ? root.child('events/' + $eventId + '/creatorId').val() === auth.uid : (root.child('proposals/' + $eventId).exists() ? root.child('proposals/' + $eventId + '/creatorId').val() === auth.uid : true))",
        ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 3000000"
      }
    },
    "eventChats": {
      ".read": "auth != null",
      "$chatId": {
        ".write": "auth != null && !newData.exists() && (root.child('events/' + $chatId).exists() ? root.child('events/' + $chatId + '/creatorId').val() === auth.uid : (root.child('proposals/' + $chatId).exists() ? root.child('proposals/' + $chatId + '/creatorId').val() === auth.uid : true))",
        "messages": {
          "$messageId": {
            ".write": "auth != null && !data.exists() && newData.exists() && (root.child('events/' + $chatId).exists() ? root.child('events/' + $chatId + '/participants/' + auth.uid).val() === true : root.child('proposals/' + $chatId).exists())",
            ".validate": "newData.hasChildren(['deviceId', 'name', 'text', 'timestamp']) && newData.child('deviceId').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 2000"
          }
        }
      }
    },
    "chatReadStatus": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".validate": "newData.hasChildren(['lastReadTimestamp']) && newData.child('lastReadTimestamp').isNumber()"
        }
      }
    },
    "proposals": {
      ".read": "auth != null",
      "$proposalId": {
        ".write": "auth != null && (data.exists() ? data.child('creatorId').val() === auth.uid : newData.child('creatorId').val() === auth.uid)",
        "dateOptions": {
          "$optionKey": {
            ".write": "auth != null"
          }
        },
        "votes": {
          "$optionKey": {
            "$voter": {
              ".write": "auth != null && auth.uid === $voter"
            }
          }
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "$connectionId": {
          ".validate": "!newData.exists() || newData.hasChildren(['active']) && newData.child('active').isBoolean()"
        }
      }
    }
  }
}
